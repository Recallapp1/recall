# ─── Uygulama ───────────────────────────────────────────────
# Public URL. Lokalde tünel URL'i (cloudflared/ngrok), prod'da alan adı.
APP_URL=http://localhost:3000

# ─── Veritabanı ─────────────────────────────────────────────
# Lokal: pnpm db:local (PGlite) veya pnpm db:up (Docker). Prod: Neon pooled URL (Vercel otomatik ekler).
DATABASE_URL=postgres://recall:recall@localhost:5433/recall
# pnpm db:local (PGlite) eşzamanlı bağlantılarda kararsızlaşır: 1 yapın. Docker/Neon için boş bırakın (10).
DATABASE_POOL_MAX=1

# ─── Sesli asistan (Retell AI) ──────────────────────────────
# Kurulum: docs/02-voice-agent/RETELL-SETUP.md
# Retell Dashboard → API Keys. Webhook rozetli (webhook badge) anahtar olmalı.
RETELL_API_KEY=
# Türkçe konuşabilen ses. Listelemek için: pnpm voice:voices
RETELL_VOICE_ID=
# Retell'in desteklediği model: claude-5-sonnet | claude-4.6-sonnet | claude-4.5-sonnet | claude-4.5-haiku
RETELL_LLM_MODEL=claude-5-sonnet
# Seslendirme modeli; sesin sağlayıcısına ait olmalı. ElevenLabs için Türkçe tutarlılığı: eleven_multilingual_v2
RETELL_VOICE_MODEL=eleven_multilingual_v2

# ─── SMS ────────────────────────────────────────────────────
# console | netgsm
SMS_PROVIDER=console
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ─── Hesaplar (Better Auth) ─────────────────────────────────
# Oturum çerezlerini imzalar. Prod'da zorunlu, en az 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Panelin adresi (giriş ve e-posta bağlantıları). Boşsa APP_URL. Lokalde tünel kullanıyorsanız:
BETTER_AUTH_URL=http://localhost:3000

# ─── E-posta (ADR-006) ──────────────────────────────────────
# console (lokal: bağlantılar terminale yazılır) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Recall <bildirim@recall.local>"

# ─── Cron (prod) ────────────────────────────────────────────
CRON_SECRET=
