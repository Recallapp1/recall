# ─── Uygulama ───────────────────────────────────────────────
# Public URL. Lokalde tünel URL'i (cloudflared/ngrok), prod'da alan adı.
APP_URL=http://localhost:3000

# ─── Veritabanı ─────────────────────────────────────────────
# Lokal: pnpm db:local (PGlite) veya pnpm db:up (Docker). Prod: Neon pooled URL (Vercel otomatik ekler).
DATABASE_URL=postgres://recall:recall@localhost:5433/recall
# pnpm db:local (PGlite) eşzamanlı bağlantılarda kararsızlaşır: 1 yapın. Docker/Neon için boş bırakın (10).
DATABASE_POOL_MAX=1

# ─── Sesli asistan (Retell AI) ──────────────────────────────
# Kurulum: docs/02-voice-agent/RETELL-SETUP.md
# Retell Dashboard → API Keys. Webhook rozetli (webhook badge) anahtar olmalı.
RETELL_API_KEY=
# Türkçe konuşabilen ses. Listelemek için: pnpm voice:voices
RETELL_VOICE_ID=
# Retell'in desteklediği model: claude-5-sonnet | claude-4.6-sonnet | claude-4.5-sonnet | claude-4.5-haiku
RETELL_LLM_MODEL=claude-4.5-haiku
# Seslendirme modeli; sesin sağlayıcısına ait olmalı. Production: eleven_flash_v2_5 (Türkçe, hızlı, ek ücret yok).
# Alternatif: eleven_multilingual_v2 (daha yavaş ilk ses)
RETELL_VOICE_MODEL=eleven_flash_v2_5
# Retell'in öncelikli LLM havuzu: Claude modelleri için sunulmuyor (ADR-003); kapalı kalır
RETELL_LLM_HIGH_PRIORITY=false
# Gecikme ayarları (ADR-003 seçenek A). Tanımsız = bugünkü davranış; silmek geri alır.
# full | compact (aynı kurallar, kısa prompt)
VOICE_PROMPT_VARIANT=full
# 0-1; tanımsızsa Retell varsayılanı (1 = en hızlı, düşük değer daha uzun bekler)
RETELL_RESPONSIVENESS=
# 0-1; tanımsızsa Retell varsayılanı (1)
RETELL_INTERRUPTION_SENSITIVITY=
# true: yanıt zamanlaması arayanın konuşma hızına uyar (yavaş konuşanı bekler)
RETELL_DYNAMIC_RESPONSIVENESS=
# true: aramadan sonra kayıtla uyuşmayan sonuç ve acil/tıbbi risk işaretleri (panelde rozet). Tanımsız = kapalı
POST_CALL_FLAGS=
# true: aramanın Retell gecikmesi (uçtan uca, ASR, LLM, TTS; p50/p90/max) calls.latency'ye yazılır. Tanımsız = yazılmaz
CALL_LATENCY_STORE=
# true: güçlendirilmiş prompt (önce güvenlik, klinik metni güvenilmeyen veri, kayıt itirazı ve sistem hatası kuralları, örnek ad/numara yok). Tanımsız = bugünkü prompt
VOICE_PROMPT_HARDENING=
# true: acil durum kuralı talimatın en başında, sabit cümle "Lütfen hemen yüz on ikiyi arayın." ve genişletilmiş belirti listesiyle (güçlendirilmiş sürümün yalnızca bu kuralı). Ajan tanımı değişir. Tanımsız = bugünkü talimat
VOICE_EMERGENCY_FIRST=
# true: aktarma yapılamıyorsa (numara yok veya mesai dışı) asistan acil durum cümlesinden sonra görüşmeyi kapatır, arayan 112'yi hemen arayabilsin; arayan konuşuyorsa kapatmaz. Ajan tanımı değişir. Tanımsız = bugünkü talimat
VOICE_EMERGENCY_END_CALL=
# true: sahip ve yöneticiler Ayarlar → Kullanım ve sınırlar sayfasını görür (salt okunur). Tanımsız = sayfa yok
PANEL_LIMITS_VIEW=
# true: hasta, randevu, onay ve ayar değişikliklerinin denetim kaydı kritik (yazılamazsa eylem başarısız + alarm). Tanımsız = bugünkü ayrım
AUDIT_STRICT=
# Tanımlıysa /api/health/jobs ayrıntıları yalnızca x-health-token başlığıyla verir (durum kodu herkese aynı). Tanımsız = bugünkü yanıt
HEALTH_JOBS_TOKEN=
# true: randevu/iptal/erteleme/geri arama istekleri arama ve tool çağrısına göre tekil; tekrar ilk sonucu döndürür. Tanımsız = kapalı
VOICE_TOOL_IDEMPOTENCY=
# true: tool çalışmadan önce veritabanı hatası olursa HTTP 500 yerine dürüst ok:false yanıtı (G-03). Tanımsız = bugünkü davranış
VOICE_TOOL_FAILSAFE=
# true: birden fazla kişi adına randevusu olan numarada ad, tarih ve saat doğrulaması (arayan numara görünse de). Tanımsız = kapalı
VOICE_SHARED_NUMBER_CHECK=
# true: aynı numarayı paylaşan aile bireyleri ayrı hasta kaydı alır (P-12; benzersiz numara indeksi kaldırılana kadar mevcut hastaya düşer). Tanımsız = kapalı, numara başına tek hasta
PATIENTS_PER_NAME=
# true: panelde hasta adı ve telefonu düzeltilebilir (KVKK düzeltme hakkı, G-02; patients.update izni). Tanımsız = kapalı
PANEL_PATIENT_EDIT=
# true: /api/cron/provider-deletions Retell silme kuyruğunu işler (R2 5a). vercel.json'a saatlik iş eklenmeden (Vercel Pro) çalışmaz. Tanımsız = kapalı (404); günlük saklama işi kuyruğu işlemeye devam eder
DELETION_QUEUE_HOURLY=
# true: randevu hatırlatmaları saatlik /api/cron/reminders işinden gelir (smsReminderHoursBefore'a uyar), günlük iş hatırlatma planlamaz (R2 5b). vercel.json'a saatlik iş eklenmeden (Vercel Pro) açılmamalı. Tanımsız = günlük iş, bugünkü gibi
HOURLY_REMINDERS=
# true: sahip ve yöneticiler salt okunur "Yayına hazırlık" sayfasını görür (hat, asistan, SMS, silme kuyruğu, anahtarlar; R2 5c). Tanımsız = kapalı
PANEL_GO_LIVE_CHECK=
# true: aramaları görebilen ekip, arama sayfasında asistan hatasını sabit bir sebep listesiyle bildirir; denetim kaydına yalnızca sebep yazılır (R2 5d). Tanımsız = kapalı
CALL_REVIEW=
# true: sahip ve yöneticiler bir aramayı test araması olarak işaretler; işaretli aramalar ve randevuları "Bugün" sayılarına girmez (R2 5e). Tanımsız = her arama sayılır
TEST_CALL_FLAG=
# true: Recall konsolunda klinik sayfasından arama ve randevu sınırları (limits) düzenlenir; denetim kaydına yazılır (tam denetim FA-09). Tanımsız = sınırlar yalnızca veritabanından değişir
CONSOLE_LIMITS_EDIT=
# true: kayıt kapalı kliniklerde analizi hiç gelmeyen aramaların Retell kopyası günlük retention işinde silme kuyruğuna alınır (tam denetim FA-10). Tanımsız = bu kopyalar Retell'in 30 günlük kendi silmesini bekler
RECORDING_OFF_SWEEP=
# true: Recall konsol kullanıcıları hiçbir kliniğin ekibine katılamaz (konsol, CLI, davet veya üyeye konsol rolü verme). Tanımsız = katılabilir; her katılım kritik denetim kaydıdır (tam denetim FA-07)
BLOCK_CONSOLE_CLINIC_MEMBERSHIP=
# Panel oturum süresi, saat (1-168; G-05). Vardiyalar arasında paylaşılan resepsiyon bilgisayarları için (ör. 12). Tanımsız = 7 gün. Geçersiz değer (ör. "12h") her isteği bozar
PANEL_SESSION_HOURS=
# İki adımlı giriş (TOTP): off | optional | required-admins | required-all. Tanımsız = off (eklenti yüklenmez, bugünkü giriş). Karar: pilottan önce required-admins; diğer personel önce optional, bir ay sorunsuzsa required-all. Uyarı: BETTER_AUTH_SECRET değişirse kayıtlı tüm doğrulayıcılar geçersiz olur
PANEL_TWO_FACTOR=
# Konsolda (/admin) birinin iki adımlı girişini sıfırlayabilecek e-postalar, virgülle. Karar: yalnızca Recall sahibi, kliniği kayıtlı numarasından geri aradıktan sonra. Tanımsız = kimse
TWO_FACTOR_RESET_EMAILS=

# ─── SMS ────────────────────────────────────────────────────
# console | netgsm
SMS_PROVIDER=console
# Gerçek SMS ana anahtarı: yalnızca "true" açar. Netgsm ve İYS/hukuk onayı tamamlanana
# kadar TANIMLAMAYIN (production dahil). Kapalıyken tüm mesajlar "skipped" kaydedilir.
# SMS_SENDING_ENABLED=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ─── Hesaplar (Better Auth) ─────────────────────────────────
# Oturum çerezlerini imzalar. Prod'da zorunlu, en az 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Panelin adresi (giriş ve e-posta bağlantıları). Boşsa APP_URL. Lokalde tünel kullanıyorsanız:
BETTER_AUTH_URL=http://localhost:3000

# ─── E-posta (ADR-006) ──────────────────────────────────────
# console (lokal: bağlantılar terminale yazılır) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Recall <bildirim@recall.local>"

# ─── Cron (prod) ────────────────────────────────────────────
CRON_SECRET=

# ─── Hata takibi (MONITORING.md) ────────────────────────────
# Boşsa kapalı. Yalnızca sunucu; olaylar kişisel veriden arındırılır.
SENTRY_DSN=
# Boşsa Vercel ortamı (production / preview)
SENTRY_ENVIRONMENT=

# Yeni demo talebinde bilgilendirilecek Recall ekibi adresi (boşsa e-posta yok)
DEMO_REQUEST_NOTIFY_EMAIL=
