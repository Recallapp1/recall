# ─── Uygulama ───────────────────────────────────────────────
# Public URL. Lokalde tünel URL'i (cloudflared/ngrok), prod'da alan adı.
APP_URL=http://localhost:3000

# ─── Veritabanı ─────────────────────────────────────────────
# Lokal: docker compose (pnpm db:up). Prod: Neon pooled URL (Vercel otomatik ekler).
DATABASE_URL=postgres://recall:recall@localhost:5433/recall

# ─── Sesli asistan (Vapi) ───────────────────────────────────
# Vapi'deki "Server URL Secret" ile aynı olmalı. Üret: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=change-me-local-secret
# Opsiyonel (Faz 2: kayıt silme, numara yönetimi)
VAPI_API_KEY=

# Ses pipeline seçimleri (bkz. docs/02-voice-agent/VOICE-AND-LANGUAGE.md, ADR-003)
VOICE_LLM_MODEL=claude-opus-5-5
VOICE_TRANSCRIBER_PROVIDER=deepgram
VOICE_TRANSCRIBER_MODEL=nova-2
VOICE_TTS_PROVIDER=azure
VOICE_TTS_VOICE_ID=tr-TR-EmelNeural

# ─── SMS ────────────────────────────────────────────────────
# console | netgsm
SMS_PROVIDER=console
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ─── Cron (prod) ────────────────────────────────────────────
CRON_SECRET=
